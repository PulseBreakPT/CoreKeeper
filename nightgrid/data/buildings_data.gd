## Resource storage caps as a function of Warehouse level.
static func storage_for_warehouse(level: int) -> Dictionary:
	var l := maxi(level, 1)
	return {
		"cash": 4000 + 3200 * l,
		"materials": 3200 + 2600 * l,
		"fuel": 2000 + 1500 * l,
		"intel": 600 + 420 * l,
		"supplies": 1400 + 1100 * l,
		"tokens": 9999,
	}

static func order() -> Array:
	return [
		"headquarters", "operations_center", "intel_center", "barracks",
		"power_generator", "workshop", "warehouse",
		"garage", "medical_center", "training_ground",
	]

static func zone_names() -> Array:
	return ["COMMAND DECK", "ADMINISTRATION", "INDUSTRIAL YARD", "SUPPORT WING"]
