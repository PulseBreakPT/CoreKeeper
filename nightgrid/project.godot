config_version=5

[application]

config/name="Nightgrid"
config/description="Nightgrid — Clandestine Operations. Single-player 4X / base-building / expedition RPG."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
